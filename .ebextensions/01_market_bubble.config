option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    DEMO_MODE: "1"
    HISTORY_LIMIT: "500"
    HOST: "0.0.0.0"
    PORT: "8080"
    TEXT_REPEAT_SUPPRESS_MS: "120000"
    WORKSPACE_NAME: "Market Bubble Live Desk"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /healthz
