PORT=8899
HOST=0.0.0.0
TEXT_REPEAT_SUPPRESS_MS=120000

# Demo mode emits episode-aware sample messages so the UI can be tested without credentials.
DEMO_MODE=1

# Market Bubble-facing workspace copy. Leave defaults unless you want a white-label build.
WORKSPACE_NAME=Market Bubble Live Desk
WORKSPACE_EYEBROW=Internal producer console
WORKSPACE_MARK=MB
BUILD_LABEL=Market Bubble desk:
BUILD_COPY=Twitch + X + Kick into one source-labeled live feed for the room.
WORKSPACE_CONTEXT=Banks + Ansem,Prediction markets,Crypto + AI,Sports + culture,Thursdays 1PM PST
WORKSPACE_WATCHLIST=Polymarket,Bullpen,Bullpen Competition,BTC 60K,liquidations,Bitcoin,funding,open interest,Zcash,ZEC,NEAR,AI agents,HYPE,HyperLiquid,Ethereum,Solana,GTA 6,AI compute

# Twitch IRC over WebSocket.
# Create a Twitch user access token with chat:read. Token may include or omit the oauth: prefix.
TWITCH_CHANNELS=marketbubble
TWITCH_USERNAME=your_bot_login
TWITCH_TOKEN=oauth:your_twitch_token

# X filtered stream. If X_RULES is set, the app adds missing filtered-stream rules.
X_BEARER_TOKEN=your_x_bearer_token
X_RULES=marketbubble OR "Market Bubble" OR polymarket OR Bullpen OR Ansem OR Banks OR HYPE

# Kick public live chat reader. Override KICK_PUSHER_KEY if Kick changes its public Pusher app.
KICK_CHANNELS=marketbubble
KICK_PUSHER_KEY=32cbd69e4b950bf97679
KICK_PUSHER_CLUSTER=us2
